{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Build",
      "cacheVariables": {
        "NOVA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ninja-multi",
      "displayName": "Ninja Multi-Config (recommended)",
      "description": "One Build/ tree; switch configs with --config without full rebuilds.",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel;Dist"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022",
      "description": "Multi-config VS generator; switch with --config or in the IDE.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel;Dist"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Single-config Ninja tree isolated under Build/Debug.",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "Single-config Ninja tree isolated under Build/Release.",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-relwithdebinfo",
      "displayName": "Ninja RelWithDebInfo",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ninja-minsizerel",
      "displayName": "Ninja MinSizeRel",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/MinSizeRel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ninja-dist",
      "displayName": "Ninja Dist",
      "description": "Shipping build: Release-level opts, all logs stripped.",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Dist",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Dist"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-multi-debug",
      "configurePreset": "ninja-multi",
      "configuration": "Debug"
    },
    {
      "name": "ninja-multi-release",
      "configurePreset": "ninja-multi",
      "configuration": "Release"
    },
    {
      "name": "ninja-multi-relwithdebinfo",
      "configurePreset": "ninja-multi",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ninja-multi-minsizerel",
      "configurePreset": "ninja-multi",
      "configuration": "MinSizeRel"
    },
    {
      "name": "ninja-multi-dist",
      "configurePreset": "ninja-multi",
      "configuration": "Dist"
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2022-relwithdebinfo",
      "configurePreset": "vs2022",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vs2022-minsizerel",
      "configurePreset": "vs2022",
      "configuration": "MinSizeRel"
    },
    {
      "name": "vs2022-dist",
      "configurePreset": "vs2022",
      "configuration": "Dist"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "ninja-relwithdebinfo",
      "configurePreset": "ninja-relwithdebinfo"
    },
    {
      "name": "ninja-minsizerel",
      "configurePreset": "ninja-minsizerel"
    },
    {
      "name": "ninja-dist",
      "configurePreset": "ninja-dist"
    }
  ]
}